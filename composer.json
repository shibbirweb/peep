{
    "name": "shibbirweb/peep",
    "description": "Debug any PHP app in a separate window: values, queries, jobs, logs, exceptions, mail and SMS.",
    "keywords": [
        "debug",
        "debugger",
        "dump",
        "laravel",
        "php",
        "queries",
        "mail",
        "sms",
        "webhook"
    ],
    "homepage": "https://github.com/shibbirweb/peep",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MD. Shibbir Ahmed",
            "homepage": "https://github.com/shibbirweb"
        }
    ],
    "support": {
        "issues": "https://github.com/shibbirweb/peep/issues",
        "source": "https://github.com/shibbirweb/peep"
    },
    "require": {
        "php": ">=7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5.20 || ^8.5.40 || ^9.6 || ^11.5 || ^12.5",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "ShibbirWeb\\Peep\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ShibbirWeb\\Peep\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": {
                "PKSA-z3gr-8qht-p93v": "CVE-2026-24765 affects PHPUnit 7.5, the only PHPUnit for PHP 7.1. It is in PHPT code coverage handling, which this project does not use, and PHPUnit is a dev dependency only."
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "tools:install": "composer install --working-dir=tools",
        "cs": "tools/vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "tools/vendor/bin/php-cs-fixer fix",
        "analyse": "tools/vendor/bin/phpstan analyse --memory-limit=1G",
        "compat": "tools/vendor/bin/phpcs --standard=phpcs.xml.dist",
        "check": [
            "@test",
            "@cs",
            "@analyse",
            "@compat"
        ]
    }
}
