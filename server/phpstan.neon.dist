# Viewer static analysis (PHP 8.5 only).
parameters:
    level: 9
    phpVersion: 80500
    paths:
        - src
        - tests
    excludePaths:
        # Runs on the PHP and Monolog versions whose output it records, not on the viewer's.
        - tests/Fixture/logs/make.php
    bootstrapFiles:
        - vendor/autoload.php
