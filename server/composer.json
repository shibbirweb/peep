{
    "name": "shibbirweb/peep-server",
    "description": "Peep viewer: receives events from the Peep client and shows them in the browser or the desktop app.",
    "homepage": "https://github.com/shibbirweb/peep",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "MD. Shibbir Ahmed",
            "homepage": "https://github.com/shibbirweb"
        }
    ],
    "require": {
        "php": ">=8.5",
        "amphp/amp": "^3.1",
        "amphp/byte-stream": "^2.1",
        "amphp/http-server": "^3.4",
        "amphp/http-server-form-parser": "^2.0",
        "amphp/pipeline": "^1.2",
        "amphp/socket": "^2.4",
        "psr/log": "^3.0",
        "revolt/event-loop": "^1.0",
        "zbateson/mail-mime-parser": "^3.0"
    },
    "require-dev": {
        "amphp/http-client": "^5.3",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "ShibbirWeb\\PeepServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShibbirWeb\\PeepServer\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "cs": "../tools/vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "../tools/vendor/bin/php-cs-fixer fix",
        "analyse": "../tools/vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@test",
            "@cs",
            "@analyse"
        ],
        "build:ui": "cd resources/ui && bun install && bun run build",
        "build:phar": "@php -d phar.readonly=0 ../tools/vendor/bin/box compile --no-interaction",
        "test:ui": "cd resources/ui && bun test src"
    }
}
