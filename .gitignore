# Dependencies
/vendor/
/tools/vendor/
/server/vendor/

# The client is a library: no lock file. The viewer and tools commit theirs.
/composer.lock

# Tool caches
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.phpcs-cache

# Local overrides
/phpunit.xml
/server/phpunit.xml
/phpstan.neon
/server/phpstan.neon
/peep.php

# Build output
/build/
/server/build/
*.phar

# Viewer UI: dependencies and build output (built in CI before the PHAR)
/server/resources/ui/node_modules/
/server/public/

# Website: dependencies, the docs copied from docs/wiki, and build output
/website/node_modules/
/website/docs/
/website/public/images/
/website/.vitepress/cache/
/website/.vitepress/dist/
/website/.vitepress/versions/

# Editors and OS
.idea/
.vscode/
.DS_Store
