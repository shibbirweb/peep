# Normalise line endings.
* text=auto eol=lf

# Keep everything except the client out of the archive Composer downloads,
# so `composer require shibbirweb/peep` installs only the client.
/.github                export-ignore
/resources/global       export-ignore
/box.json.dist          export-ignore
/desktop                export-ignore
/docs                   export-ignore
/packaging              export-ignore
/scripts                export-ignore
/server                 export-ignore
/tests                  export-ignore
/tools                  export-ignore
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.php-cs-fixer.dist.php export-ignore
/CONTRIBUTING.md        export-ignore
/SECURITY.md            export-ignore
/phpcs.xml.dist         export-ignore
/phpstan.neon.dist      export-ignore
/phpunit.xml.dist       export-ignore
/phpunit.laravel.xml.dist export-ignore
