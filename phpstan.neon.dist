# Client static analysis: types and bugs.
#
# PHP 7.1 compatibility is not checked here. PHPStan judges functions and classes by
# the PHP it runs on, and setting phpVersion to 70100 stops it from reading the newer
# PHPUnit installed for analysis. Compatibility is covered by PHPCompatibility
# (phpcs.xml.dist), `php -l` on PHP 7.1 and the test suite on every PHP version in CI.
parameters:
    level: 8
    # Docblock types describe the newest Laravel and PHP; the code still checks at runtime
    # (method_exists(), class_exists(), is_*()) for the oldest supported versions. Those
    # checks are needed, so PHPStan must not call them redundant.
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - tests
    bootstrapFiles:
        - vendor/autoload.php
    # Laravel is not a dependency of the client; the tools package installs it (with
    # Testbench) so the adapter in src/Laravel and its tests can be analysed.
    scanDirectories:
        - tools/vendor/laravel/framework/src
        - tools/vendor/orchestra/testbench-core/src
    excludePaths:
        analyseAndScan:
            # The polyfill declares TestCase twice and loads one at runtime by PHPUnit
            # version; PHPStan runs with a current PHPUnit, so it must see the Gte8 one.
            - vendor/yoast/phpunit-polyfills/src/TestCases/TestCasePHPUnitLte7.php
        analyse:
            # The Monolog 1 and 2 handler; analysing it against the installed Monolog 3 is
            # meaningless (Monolog 3 has PeepLogRecordHandler). It is covered by the test
            # runs on PHP versions that install Monolog 1 and 2.
            - src/Bridge/Monolog/PeepHandler.php
            # The SwiftMailer transport (Laravel 5.5 to 8); the installed Laravel uses Symfony
            # Mailer. Covered by the Laravel 5.5 to 8 test runs.
            - src/Laravel/Mail/PeepSwiftTransport.php
